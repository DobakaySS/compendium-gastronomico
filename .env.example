NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Obrigatório para o link de "recuperar senha" em produção (ex: https://app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Chave da API Gemini para importação inteligente de receitas (Fase 3)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modelo Gemini (padrão: flash-lite, gratuito com alto limite)
GEMINI_MODEL=gemini-3.5-flash-lite

